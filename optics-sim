    color:#38bdf8;
}

.cs-trigger.open .arrow{
    transform:rotate(180deg);
}

.cs-options{
    margin-top:6px;
    background:#0c2942;
    border:1px solid #38bdf8;
    border-radius:9px;
    max-height:220px;
    overflow-y:auto;
    display:none;
}

.cs-options.open{
    display:block;
}

.cs-option{
    padding:11px 12px;
    cursor:pointer;
    font-size:15px;
    color:#e6f8ff;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.cs-option:last-child{
    border-bottom:none;
}

.cs-option:hover,
.cs-option.selected{
    background:#00a8e8;
    color:#fff;
}

select.native-select-hidden{
    display:none;
}

#mainContent{
    display:none;
}

/* ===== زر تدوير الشاشة ===== */

#rotateBtn{
    position:absolute;
    top:52px;
    left:14px;
    z-index:50;
    width:42px;
    height:42px;
    border-radius:50%;
    border:2px solid #3ebfff;
    background:linear-gradient(135deg,#00a8e8,#006fc9);
