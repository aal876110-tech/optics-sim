        padding:8px;
    }

    header{
        padding:13px;
    }

    .card{
        padding:12px;
    }

    .results{
        gap:7px;
    }

    .result{
        padding:10px 5px;
    }

    .result .number{
        font-size:19px;
    }
}
</style>
</head>

<body>

<div id="startScreen">
    <div class="start-box">
        <div class="start-icon">🌈</div>
        <h1>محاكي الانعكاس والانكسار</h1>
        <div class="subject">تجربة في فيزياء الرابع العلمي</div>

        <div class="start-teacher">👨‍🏫 إعداد الأستاذ علي عبدالستار</div>
        <div class="start-rights">© جميع الحقوق محفوظة للأستاذ علي عبدالستار</div>

        <button id="startBtn">🚀 ابدأ التجربة</button>
    </div>
</div>

<div id="mainContent">
<div class="container">

<header>
    <button id="rotateBtn" title="تدوير الشاشة">🔄</button>
    <h1>🌈 محاكي الانعكاس والانكسار</h1>
    <p>فيزياء الرابع العلمي</p>
    <div class="author">👨‍🏫 إعداد الأستاذ علي عبدالستار</div>
</header>

<div class="controls">

    <div class="card">
        <h2>💧 الوسط الأول</h2>

        <label>اختر الوسط:</label>

        <select id="medium1">
            <option value="1.00">الهواء — n = 1.00</option>
            <option value="1.330070568294512">الماء — n = 1.33</option>
            <option value="1.5212011806012264" selected>الزجاج — n = 1.52</option>
            <option value="2.419764435660177">الألماس — n = 2.42</option>
        </select>
    </div>


    <div class="card">
        <h2>🔮 الوسط الثاني</h2>

        <label>اختر الوسط:</label>

        <select id="medium2">
            <option value="1.00" selected>الهواء — n = 1.00</option>
            <option value="1.330070568294512">الماء — n = 1.33</option>
            <option value="1.5212011806012264">الزجاج — n = 1.52</option>
            <option value="2.419764435660177">الألماس — n = 2.42</option>
        </select>
    </div>


    <div class="card">
        <h2>🪞 نوع الظاهرة</h2>

        <label>اختر الظاهرة:</label>
        <select id="mode">
            <option value="both">الانعكاس والانكسار</option>
            <option value="reflection">الانعكاس فقط</option>
            <option value="refraction">الانكسار فقط</option>
        </select>

        <label>زاوية السقوط:
            <span class="value" id="angleValue">40.00°</span>
        </label>

        <input
            id="angle"
            type="range"
            min="1"
            max="90"
            value="40"
            step="1"
        >

        <div class="fraction-block">
            <label>الجزء العشري (يُضاف لأي درجة):
                <span class="value" id="fractionValue">.00</span>
            </label>

            <input
                id="angleFraction"
                type="range"
