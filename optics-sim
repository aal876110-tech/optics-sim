<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>محاكي الانعكاس والانكسار - الأستاذ علي عبدالستار</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    background:#08152f;
}

body{
    font-family:Tahoma,Arial,sans-serif;
    background:linear-gradient(135deg,#08152f,#102d52,#173e68);
    color:#fff;
    min-height:100vh;
    padding:15px;
}

.container{
    max-width:1200px;
    margin:auto;
}

header{
    position:relative;
    text-align:center;
    background:linear-gradient(135deg,#123b6d,#176b9f);
    border:2px solid #3ebfff;
    border-radius:20px;
    padding:18px;
    margin-bottom:15px;
    box-shadow:0 8px 25px rgba(0,0,0,.35);
}

header h1{
    font-size:clamp(22px,4vw,34px);
    color:#fff;
    margin-bottom:7px;
}

header p{
    color:#bdeeff;
    font-size:16px;
}

.author{
    display:inline-block;
    margin-top:10px;
    background:#082746;
    border-radius:30px;
    padding:7px 16px;
    color:#ffd85a;
    font-weight:bold;
}

.controls{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-bottom:15px;
}

.card{
    position:relative;
    background:rgba(255,255,255,.09);
    border:1px solid rgba(255,255,255,.2);
    border-radius:17px;
    padding:15px;
    box-shadow:0 6px 20px rgba(0,0,0,.2);
    backdrop-filter:blur(8px);
}

.card h2{
    color:#59d5ff;
    font-size:18px;
    margin-bottom:12px;
}

label{
    display:block;
    margin:8px 0 5px;
    color:#e6f8ff;
    font-weight:bold;
}

select,input[type=range]{
    width:100%;
}

select{
    background:#092846;
    color:#fff;
    border:1px solid #38bdf8;
    border-radius:9px;
    padding:9px;
    font-size:15px;
}

input[type=range]{
    accent-color:#38bdf8;
    cursor:pointer;
}

.value{
    color:#ffd85a;
    font-weight:bold;
    float:left;
}

.fraction-block{
    margin-top:12px;
    padding-top:10px;
    border-top:1px dashed rgba(255,255,255,.2);
}

.angle-precise-row{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:10px;
}

.inline-label{
    margin:0;
    white-space:nowrap;
    font-size:14px;
}

#angleNumber{
    background:#092846;
    color:#ffd85a;
    font-weight:bold;
    border:1px solid #38bdf8;
    border-radius:9px;
    padding:8px;
    font-size:15px;
    width:100%;
    text-align:center;
}

.range-warning.show{
    display:block;
}

button{
    width:100%;
    border:none;
    border-radius:11px;
    padding:11px;
    background:linear-gradient(135deg,#00a8e8,#006fc9);
    color:#fff;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    margin-top:8px;
}

button:active{
    transform:scale(.98);
}

.simulation{
    background:#061525;
    border:2px solid #267ba8;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 10px 30px rgba(0,0,0,.4);
}

.sim-title{
    padding:12px 16px;
    background:#0c2942;
    color:#fff;
    font-weight:bold;
    text-align:center;
}

canvas{
    display:block;
    width:100%;
    height:auto;
    background:#020b16;
}

.results{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
    margin-top:15px;
}

.result{
    background:linear-gradient(135deg,#12365a,#0a243d);
    border:1px solid #287da8;
    border-radius:15px;
    padding:13px;
    text-align:center;
    transition:opacity .2s;
}

.result.dim{
    opacity:.35;
}

.result .number{
    display:block;
    color:#ffd85a;
    font-size:22px;
    font-weight:bold;
    margin-top:5px;
}

.explanation{
    margin-top:15px;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.18);
    border-radius:18px;
    padding:17px;
    line-height:1.9;
}

.explanation h2{
    color:#59d5ff;
    margin-bottom:8px;
}

.formula{
    direction:ltr;
    text-align:center;
    background:#061b2d;
    color:#ffd85a;
    padding:12px;
    border-radius:10px;
    margin:10px 0;
    font-size:20px;
    font-weight:bold;
}

.note{
    color:#bdeeff;
}

footer{
    text-align:center;
    margin-top:15px;
    color:#8fcde6;
    font-size:13px;
}

/* ===== شاشة البداية ===== */

#startScreen{
    position:fixed;
    inset:0;
    z-index:999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:radial-gradient(circle at 50% 20%,#164b7a,#08152f 70%);
}

.start-box{
    max-width:480px;
    width:100%;
    text-align:center;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.2);
    border-radius:24px;
    padding:40px 28px;
    box-shadow:0 15px 40px rgba(0,0,0,.45);
    backdrop-filter:blur(8px);
}

.start-icon{
    font-size:54px;
    margin-bottom:10px;
}

.start-box h1{
    font-size:clamp(22px,5vw,30px);
