    margin-bottom:28px;
}

#startBtn{
    width:100%;
    border:none;
    border-radius:14px;
    padding:15px;
    background:linear-gradient(135deg,#00a8e8,#006fc9);
    color:#fff;
    font-size:19px;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 8px 20px rgba(0,111,201,.4);
}

#startBtn:active{
    transform:scale(.98);
}

.custom-select{
    position:relative;
}

.cs-trigger{
    width:100%;
    background:#092846;
    color:#fff;
    border:1px solid #38bdf8;
    border-radius:9px;
    padding:9px;
    font-size:15px;
    font-family:inherit;
    text-align:right;
    cursor:pointer;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
}

.cs-trigger .arrow{
